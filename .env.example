# Your Cloudinary cloud name (Console → Dashboard → Product Environment)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# An UNSIGNED upload preset with the Cloudinary AI Content Analysis (object detection)
# and Amazon Rekognition AI Moderation add-ons enabled, e.g. docs_gen_ai_color_demo
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
